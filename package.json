{
  "name": "kiwipath",
  "private": true,
  "version": "0.1.0",
  "description": "KiwiPath: a step-by-step companion for Sri Lankans moving to New Zealand to study or work.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --mode preview && node scripts/build-preview.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:topo": "node scripts/gen-topo.mjs",
    "gen:seed": "vite-node scripts/gen-seed.ts",
    "validate:sql": "node scripts/validate-sql.mjs",
    "screens": "node scripts/screens.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,ts}\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "d3-contour": "4.0.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-node": "3.2.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
